# EmailJS — public identifiers, inlined into the browser bundle at build time.
# Create the service + template at https://dashboard.emailjs.com, then paste
# their IDs here. The Gmail credential stays in the EmailJS dashboard and never
# enters this repository or the client bundle.
#
# In EmailJS: Account → Security → Allowed origins must list every origin the
# form is served from:
#   https://chvmkiran.github.io
#   https://www.chvmkiran.me
#   http://localhost:3000
#   http://127.0.0.1:3000
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Public site origin, used for canonical + Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://www.chvmkiran.me
